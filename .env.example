# Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_AUDIENCE=chbn-api

# Rate limiting (slowapi format, e.g. "60/minute", "10/second")
RATE_LIMIT=30/minute

# CORS (comma-separated origins; empty defaults to ["*"] in dev mode)
CORS_ORIGINS=http://localhost:5173

# AI Provider
OPENAI_API_KEY=

# LLM Explainer (Phase 8)
LLM_PROVIDER=openai
LLM_ENABLED=false
LLM_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_MS=5000
MAX_EXPLAINER_RETRIES=1

# Embedding (Phase 8)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=10000

# Database
# For host-run API (pytest, local uvicorn): use localhost
DATABASE_URL=postgresql://chbn:chbn_dev@localhost:5432/chbn
# For docker compose network: use service name 'db' (set automatically by compose)
# DATABASE_URL=postgresql://chbn:chbn_dev@db:5432/chbn
POSTGRES_USER=chbn
POSTGRES_PASSWORD=chbn_dev
POSTGRES_DB=chbn

# Repo mode: csv_only | db_first (default: db_first when DATABASE_URL is set)
# Set to csv_only to bypass DB entirely (safe rollback path)
REPO_MODE=db_first

# Frontend
VITE_API_BASE_URL=http://localhost:8000
