* text=auto

# Shell / scripts
*.sh text eol=lf
*.bash text eol=lf

# Config / infra
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf

# Python
*.py text eol=lf

# Docs
*.md text eol=lf

# Dockerfiles
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Windows scripts remain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
