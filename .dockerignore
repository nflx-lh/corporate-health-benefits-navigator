.git
.gitignore
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.ipynb_checkpoints
**/*.py[cod]
**/*.pyo
**/*.pyd

# Python envs
.venv
venv
env

# Frontend
**/node_modules
**/dist
**/build
**/.vite

# Test / coverage artifacts
**/.coverage
**/coverage
**/htmlcov
**/test-results
**/playwright-report

# OS / editor junk
.DS_Store
Thumbs.db
.vscode
.idea

# Runtime/log artifacts
**/*.log
eval/artifacts/*
!eval/artifacts/.gitkeep

# Env files
.env
.env.*
!.env.example
